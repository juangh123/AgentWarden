{
  "name": "agentwarden",
  "version": "0.2.0",
  "description": "Zero-dependency Security Warden, Supply-Chain Linter & Integrity Manager for AI Agent Skills",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./cli": "./dist/cli.js"
  },
  "bin": {
    "agentwarden": "dist/cli.js",
    "warden": "dist/cli.js",
    "skillguard": "dist/cli.js"
  },
  "type": "module",
  "license": "MIT",
  "keywords": [
    "ai-agent",
    "skills",
    "mcp",
    "security",
    "audit",
    "prompt-injection",
    "sast",
    "cli",
    "supply-chain"
  ],
  "engines": {
    "node": ">=22.6.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "skills.lock"
  ],
  "scripts": {
    "build": "npm run clean && tsc",
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types --no-warnings tests/*.test.ts",
    "smoke": "npm run build && node scripts/e2e-smoke.mjs",
    "start": "node --experimental-strip-types --no-warnings src/cli.ts",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}